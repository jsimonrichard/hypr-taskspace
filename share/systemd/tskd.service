[Unit]
Description=Hypr Taskspace daemon
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=@TSK_CMD@ daemon run
Environment=PATH=%E/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
# process: only signal the daemon. mixed/control-group also SIGKILLs terminals and
# other GUI apps the daemon spawned (they stay in this cgroup), which makes
# `systemctl --user restart tskd` close the terminal that ran the restart.
KillMode=process
KillSignal=SIGTERM
PassEnvironment=WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_RUNTIME_DIR XDG_CURRENT_DESKTOP DISPLAY

[Install]
WantedBy=graphical-session.target
