# Pacman replaces /usr/share/tsk with remove-then-add. Hyprland auto-reloads
# sourced files while they are missing and can get stuck until a later reload.
# Run after the transaction so the share tree is complete again.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/share/tsk/hypr/*

[Action]
Description = Reloading Hyprland after tsk share update...
When = PostTransaction
Depends = hyprland
Exec = /usr/share/libalpm/scripts/hypr-taskspace-reload-hyprland
